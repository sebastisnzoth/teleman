APP_NAME=Teleman
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
# Other hosts this site answers to besides APP_URL's (and its www. twin), comma-separated
APP_TRUSTED_HOSTS=
# Keep one copy of .env in storage/backups/env so an emptied .env can be restored (false keeps none)
ENV_BACKUPS=true
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
# For development, use sqlite. For production, use mysql.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=teleman
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe Payment Gateway Configuration
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_MODE=true
STRIPE_FEE_PERCENTAGE=2.9
STRIPE_FEE_FIXED=0.30

# Razorpay Payment Gateway Configuration
RAZORPAY_API_KEY=
RAZORPAY_SECRET_KEY=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TEST_MODE=true
RAZORPAY_FEE_PERCENTAGE=2.0
RAZORPAY_FEE_FIXED=0.0

VITE_APP_NAME="${APP_NAME}"

# API Configuration
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_DEFAULT=60
API_RATE_LIMIT_HIGH=1000
API_RATE_LIMIT_ADMIN=10000

# CORS Configuration
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://yourdomain.com"

# Swagger Documentation
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_UI_PERSIST_AUTHORIZATION=true
L5_SWAGGER_CONST_HOST="${APP_URL}"

AI_AUTO_CONFIGURE_TWILIO=true

# ==================== TELEPHONY ====================

# This application runs on ONE telephony provider. You choose it once, in
# the web installer, and that choice is stored in the database (the
# provider lock), not here. This variable is only the provider a FRESH
# install starts on; editing it later does not switch an installation that
# is already locked, and neither does editing the credentials below.
#
# To change providers after install, use "Reset telephony" on the admin
# Telephony Settings page. That is destructive: it deletes this
# installation's provider credentials and trunks and retires its phone
# numbers. Your users, credits, contacts, campaigns and call/SMS history
# are kept. Nothing is cancelled in your provider account either: numbers
# there stay live and keep billing until you cancel them yourself.
TELEPHONY_PROVIDER=twilio

# Twilio credentials: used when this installation is locked to Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Plivo credentials: used when this installation is locked to Plivo. An
# admin can also enter these on the Telephony Settings page after install.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# ==================== AI AGENT CALLING ====================

# Deepgram API (Speech-to-Text)
DEEPGRAM_API_KEY=

# OpenAI API (Text-to-Speech)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# OpenRouter API (LLM for AI Agent conversations)
OPENROUTER_API_KEY=

# AI Agent Settings
AI_AGENT_DEFAULT_MODEL=gpt-3.5-turbo
AI_AGENT_MAX_TOKENS=500
AI_AGENT_TEMPERATURE=0.7
AI_AGENT_USE_OPENAI=true

# Laravel Reverb (WebSocket Server)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Sentry Error Tracking (optional)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Sentry Frontend Configuration
VITE_SENTRY_DSN="${SENTRY_LARAVEL_DSN}"
VITE_SENTRY_ENVIRONMENT="${APP_ENV}"
VITE_SENTRY_TRACES_SAMPLE_RATE="${SENTRY_TRACES_SAMPLE_RATE}"
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE="${SENTRY_TRACES_SAMPLE_RATE}"

# Cryptomus Cryptocurrency Payment Gateway
CRYPTOMUS_MERCHANT_UUID=
CRYPTOMUS_PAYMENT_KEY=
CRYPTOMUS_TEST_MODE=true

# Cloudflare Turnstile bot protection on login/registration. Leave off until
# you have created a widget at dash.cloudflare.com and pasted both keys.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
